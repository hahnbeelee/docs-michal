  "name": "Hahnbee's Docs",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
